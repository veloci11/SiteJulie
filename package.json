{
  "name": "galerie-atelier",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "build:vercel": "node scripts/check-hosting-env.mjs && next build",
    "start": "node scripts/start-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "media:prepare": "node scripts/prepare-artworks.mjs",
    "admin:hash": "node scripts/hash-admin-password.mjs",
    "blob:seed": "node scripts/seed-vercel-blob.mjs",
    "format": "prettier --write app components lib tests scripts/*.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.99.1",
    "@tailwindcss/postcss": "4.2.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "camera-controls": "3.1.2",
    "lucide-react": "0.577.0",
    "next": "16.3.8",
    "playwright-core": "1.63.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "three": "0.186.0",
    "zod": "4.3.6",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
