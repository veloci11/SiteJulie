# LOCAL DEMO: copies of supplied art, filesystem persistence, localhost only.
MUSEUM_DATA_MODE=demo
# Needed only for a LOCAL production-build preview. Never enable on a public host.
MUSEUM_LOCAL_PREVIEW=1
# Optional absolute path for an isolated test dataset. Defaults to project/.local
MUSEUM_LOCAL_DATA_DIR=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
MUSEUM_PUBLIC_INDEXING=0

# SIMPLE VERCEL HOSTING: one admin account and a private Vercel Blob store.
# Use MUSEUM_DATA_MODE=blob on Vercel. Keep every value below server-side only.
BLOB_READ_WRITE_TOKEN=
MUSEUM_ADMIN_USERNAME=
MUSEUM_ADMIN_PASSWORD_HASH=
MUSEUM_SESSION_SECRET=

# CONTACT FORM — server only. FROM must belong to a domain verified in Resend.
# Messages go to the public email configured in /admin > Textes & contact.
# Never put the visitor's email in FROM; it is used as Reply-To.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_FORM_ENABLED=0
CONTACT_EMAIL_MIGRATION_FROM=
CONTACT_EMAIL_MIGRATION_TO=

# OPTIONAL SUPABASE BACKEND: use MUSEUM_DATA_MODE=supabase.
# Run the migration and create an administrator as documented before using.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The Vercel integration can provide this instead of ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# The Vercel integration can provide this instead of SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Informations publiques confirmées pour les pages légales (ne pas inventer d’adresse).
SITE_EDITOR_NAME=Julie Thiam
SITE_EDITOR_ADDRESS=
# Balise publique délivrée par Google Search Console.
GOOGLE_SITE_VERIFICATION=
# Hobby : budget de stockage 1 Go, mesuré en octets décimaux.
MUSEUM_STORAGE_BUDGET_BYTES=1000000000
# Secret serveur utilisé exclusivement par Vercel Cron, jamais NEXT_PUBLIC_.
CRON_SECRET=
# Optionnel : clé distincte de 32 caractères minimum pour les empreintes anti-spam.
# En son absence, MUSEUM_SESSION_SECRET est utilisé avec un contexte distinct.
CONTACT_RATE_LIMIT_SECRET=
